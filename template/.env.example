# ── Progress Agentic RAG connection (required unless ARAG_MOCK=1) ──────────────
ARAG_KB_ID=                       # Knowledge Box id (uuid)
ARAG_API_KEY=                     # KB service-account token (X-NUCLIA-SERVICEACCOUNT). Never commit.
ARAG_REGION=aws-us-east-2-1       # zone slug; or set ARAG_BASE_URL to override the host entirely
#ARAG_BASE_URL=https://aws-us-east-2-1.dp.progress.cloud/api/v1
ARAG_GENERATIVE_MODEL=            # empty = KB default (e.g. chatgpt-azure-4o)
ARAG_RERANKER=predict             # predict | noop
ARAG_TIMEOUT_MS=60000
ARAG_MOCK=0                       # 1 = use the in-process mock ARAG (no credentials needed)

# ── Service ────────────────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
DATA_DIR=./data                   # JSON stores (jobs, records, configs)
PUBLIC_URL=http://localhost:8080

# ── Security ───────────────────────────────────────────────────────────────────
ADMIN_TOKEN=                      # required to open /admin and /api/v1/admin/*; generate: openssl rand -hex 24
API_KEYS=                         # comma-separated; when set, /api/v1 routes require X-API-Key (demo UI uses a session cookie)
ALLOWED_ORIGINS=                  # comma-separated CORS origins; empty = same-origin only
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=20
MAX_BODY_BYTES=26214400
TRUST_PROXY=fly                   # fly (default: trust Fly-Client-IP) | xff (trust first X-Forwarded-For) | none

# ── White-label branding (optional; see docs/developer/white-label.md) ─────────
BRAND_PRODUCT_NAME=               # shown in header/title (default: the product's working title)
BRAND_TAGLINE=
BRAND_LOGO_URL=                   # absolute URL or /branding/logo.svg (file placed in $DATA_DIR/branding/)
BRAND_PRIMARY_COLOR=              # e.g. #2b2bb2
BRAND_ACCENT_COLOR=               # e.g. #00b563
BRAND_POWERED_BY=1                # 0 hides the "Built on Progress Agentic RAG" band and credit
BRAND_FOOTER_TEXT=
BRAND_DOCS_URL=
BRAND_SUPPORT_URL=
